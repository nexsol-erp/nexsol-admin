      <tr><td colspan=\\"3\\">CGST @7.5%</td><td class=\\"num\\">1.30</td></tr>
      <tr><td colspan=\\"3\\">SGST @7.5%</td><td class=\\"num\\">1.30</td></tr>
      <tr class=\\"tax-total\\"><td colspan=\\"3\\"><b>Total Tax</b></td><td class=\\"num\\"><b>2.61</b></td></tr>
    </tbody>
  </table>
  <hr class=\\"dash\\"/>

  
  <div class=\\"total-line\\"><span>GROSS</span><span>23.50</span></div>
  <div class=\\"total-line\\" style=\\"color:#389e0d\\"><span>DISCOUNT</span><span>-1.00</span></div>
  <div class=\\"total-line\\"><span>SUB TOTAL</span><span>22.50</span></div>
  <div class=\\"total-line\\" style=\\"font-size:11px;color:#888\\"><span>ROUND OFF</span><span>+0.50</span></div>
  <div class=\\"total-line\\"><span>NET PAYABLE</span><span>23.00</span></div>
  
  <hr class=\\"solid\\"/>

  <table class=\\"pay\\">
    <tbody>
      
      
      
    </tbody>
  </table>
